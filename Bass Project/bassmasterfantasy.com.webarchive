// Carousel

$(document).ready(function(){

  var $slider = $('.event-carousel');
  
  $slider.slick({
    dots: false,
    infinite: true,
    arrows: false,
    // centerMode: true,
    speed: 300,
    slidesToShow: 4,
    slidesToScroll: 1,
    responsive: [
      {
        breakpoint: 1024,
        settings: {
          slidesToShow: 3,
          // centerMode: true,
          slidesToScroll: 3,
          infinite: true,
        }
      },
      {
        breakpoint: 600,
        settings: {
          slidesToShow: 2,
          slidesToScroll: 2
        }
      },
      {
        breakpoint: 480,
        settings: {
          slidesToShow: 1,
          slidesToScroll: 1
        }
      }
    ]
  });
  
  // Custom navigation
  $('.custom-prev').click(function() {
    $slider.slick('slickPrev');
  });
  
  $('.custom-next').click(function() {
    $slider.slick('slickNext');
  });
  
  
      // Hide Prev button on first slide
      function updateNavButtons(currentSlide) {
        if (currentSlide === 0) {
            $('.custom-prev').hide();
        } else {
            $('.custom-prev').show();
        }
    }
  
    // Initial check
    updateNavButtons(0);
  
    // Listen to slide change event
    $slider.on('afterChange', function(event, slick, currentSlide) {
        updateNavButtons(currentSlide);
    });
  
    // Hide Arrows if Slides are Less Than or Equal to Visible Slides
    function checkSlideCount() {
      var totalSlides = $slider.find('.slick-slide').not('.slick-cloned').length; // Get actual slides
      var slidesToShow = $slider.slick('slickGetOption', 'slidesToShow'); // Get slidesToShow option
  
      if (totalSlides <= slidesToShow) {
          $('.custom-prev, .custom-next').hide();
      } else {
          $('.custom-prev, .custom-next').show();
      }
  }
  
  // Run check after Slick initializes
  $slider.on('init', function() {
      checkSlideCount();
  });
  
  $slider.on('setPosition', function() {
      checkSlideCount();
  });
  
  // Manually trigger check after initialization
  $slider.slick('setPosition');
  
  
  });_application/javascriptObplist00‘
