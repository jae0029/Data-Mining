#table-pager {
  padding: 10px 0 10px 0;
  background: #FFF;
  background: -webkit-gradient(linear, left top, left bottom, from(#efeeee), to(white));
  background: -moz-linear-gradient(top, #efeeee, white);
  text-align: center;
  width: 640px; }

#table-pager ul.pager {
  margin: 0 auto;
  padding: 0;
  display: table; }

ul.pager li {
  list-style-type: none;
  display: inline;
  font-size: 13px; }

ul.pager li a {
